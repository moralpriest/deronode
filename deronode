#!/usr/bin/env bash
# deronode — unified launcher for the DERO node manager
# Prefers PowerShell (full interactive UI) and falls back to bash for
# Termux / minimal environments. Resolves its own real path so it works
# when symlinked onto PATH (e.g. ~/.local/bin/deronode).
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$DIR/node.ps1" "$@"
fi
exec bash "$DIR/node.sh" "$@"